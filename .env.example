# Public URL of the deployed site (used for SEO metadata, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery (Resend — https://resend.com). All three are required for the form to send.
RESEND_API_KEY=
# The inbox that receives contact-form messages.
CONTACT_TO_EMAIL=
# A sender on a domain you have verified in Resend, e.g. "Portfolio <contact@your-domain.com>".
CONTACT_FROM_EMAIL=
